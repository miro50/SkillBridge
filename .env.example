# SkillBridge Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (T1 - Database Schema & Seed Setup)
# For local dev / cloud deployment, configure your Supabase project credentials:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (T3 - Semantic Grader)
GEMINI_API_KEY=your-gemini-api-key

# Founder Webhook URL (T6 - Alert Webhook)
FOUNDER_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-or-telegram
